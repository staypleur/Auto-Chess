# Copy to .env; keep credentials on your PC only.
MODE=dev
PORT=9000
MIN_HUMAN_PLAYERS=1
MONGO_URI=mongodb://127.0.0.1:27017/dev

# Firebase project > Project settings > Your apps > Web app
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Project settings > Service accounts > Generate new private key
FIREBASE_CLIENT_EMAIL=
# Put the PEM on one line with literal \n between lines, inside quotes.
FIREBASE_PRIVATE_KEY=""
