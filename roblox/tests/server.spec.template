local function join(id)
    local player={UserId=id,DisplayName='Player'..id,Parent=players,CharacterAdded=signal(),kicked=false}
    function player:Kick() self.kicked=true end
    players.PlayerAdded:Fire(player)
    return player
end
local function leave(player) player.Parent=nil;players.PlayerRemoving:Fire(player) end
local list={}
for i=1,7 do list[i]=join(i) end
assert(snapshots[list[1]].phase=='Lobby','seven must remain in lobby')
advance(1)
remotes[1].OnServerEvent:Fire(list[1],{kind='Ready'})
assert(snapshots[list[1]].phase=='Lobby','remote Ready cannot bypass eight-player gate')
list[8]=join(8)
assert(snapshots[list[1]].phase=='Starting','eighth starts countdown')
local overflow=join(9)
assert(overflow.kicked,'ninth player rejected')
advance(3)
leave(list[8])
assert(snapshots[list[1]].phase=='Lobby','leaving cancels countdown immediately')
advance(10)
assert(snapshots[list[1]].phase=='Lobby','cancelled task cannot start a game')
list[8]=join(10)
advance(8)
assert(snapshots[list[1]].phase=='Preparation','replacement eighth starts match')
local state=snapshots[list[1]].state
advance(0.2)
remotes[1].OnServerEvent:Fire(list[1],{kind='Buy',slot=1})
assert(#state.units==1,'shop works after eight-player start')
advance(0.2)
remotes[1].OnServerEvent:Fire(list[1],{kind='Move',id=state.units[1].id,x=1,y=1})
assert(state.units[1].y==1,'deployment accepted in preparation')
remotes[1].OnServerEvent:Fire(list[2],{kind='Buy',slot=1})
advance(0.2)
local opponent=snapshots[list[2]].state
remotes[1].OnServerEvent:Fire(list[2],{kind='Move',id=opponent.units[1].id,x=1,y=1})
advance(24.5)
assert(snapshots[list[1]].phase=='Battle','match advances to battle')
leave(list[8])
assert(snapshots[list[1]].phase~='Lobby','disconnect during match does not reset the running game')
