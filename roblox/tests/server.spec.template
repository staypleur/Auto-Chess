local Catalog=require('../src/shared/Catalog')
local Rules=require('../src/shared/Rules')
local Lobby=require('../src/shared/Lobby')
local function signal()
    local handlers={}
    return {Connect=function(_,callback) table.insert(handlers,callback) end,
        Fire=function(_,...) for _,callback in ipairs(handlers) do callback(...) end end}
end
local clock=0
local jobs={}
local task={}
function task.wait(delay) coroutine.yield(delay or 0) end
function task.spawn(callback)
    local thread=coroutine.create(callback)
    local ok,delay=coroutine.resume(thread)
    assert(ok,delay)
    if coroutine.status(thread)~='dead' then table.insert(jobs,{thread=thread,at=clock+delay}) end
end
local function advance(seconds)
    local finish=clock+seconds
    while true do
        local index,nextJob=nil,nil
        for i,job in ipairs(jobs) do if job.at<=finish and (not nextJob or job.at<nextJob.at) then index,nextJob=i,job end end
        if not index then break end
        table.remove(jobs,index);clock=nextJob.at
        local ok,delay=coroutine.resume(nextJob.thread);assert(ok,delay)
        if coroutine.status(nextJob.thread)~='dead' then
            table.insert(jobs,{thread=nextJob.thread,at=clock+delay})
        end
    end
    clock=finish
end
local players={PlayerAdded=signal(),PlayerRemoving=signal(),GetPlayers=function() return {} end}
