local Queue=require('../src/shared/Queue')
assert(Queue.inside(0,3,-38),'entrance center enters queue')
assert(not Queue.inside(0,3,0),'plaza outside queue')
assert(not Queue.inside(30,3,-38),'shops outside queue')
assert(not Queue.inside(0,40,-38),'vertical bounds respected')
local queue=Queue.reconcile({}, {1,2,3,4,5,6,7})
assert(#queue==7,'seven entrants')
queue=Queue.reconcile(queue,{1,2,3,4,5,6,7,8,9})
assert(#queue==8 and queue[8]==8,'ninth entrant not in active batch')
local previous=table.clone(queue)
assert(Queue.same(previous,queue),'stable roster')
queue=Queue.reconcile(queue,{1,2,3,4,5,6,7,9})
assert(#queue==8 and queue[8]==9 and not Queue.same(previous,queue),'replacement invalidates countdown')
queue=Queue.reconcile(queue,{1,2,3})
assert(#queue==3,'leaving removes queued players')
queue=Queue.reconcile(queue,{3,2,1,4})
assert(queue[1]==1 and queue[2]==2,'existing queue order preserved')
print('ALL ENTRANCE QUEUE TESTS PASSED')
