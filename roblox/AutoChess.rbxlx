[&quot;regional&quot;]=false},[&quot;ZACIAN_CROWNED&quot;]={[&quot;name&quot;]=&quot;ZACIAN_CROWNED&quot;,[&quot;family&quot;]=&quot;ZACIAN&quot;,[&quot;index&quot;]=&quot;0888-0001&quot;,[&quot;hp&quot;]=260,[&quot;attack&quot;]=22,[&quot;defense&quot;]=12,[&quot;speed&quot;]=69,[&quot;range&quot;]=1,[&quot;stars&quot;]=4,[&quot;rarity&quot;]=&quot;LEGENDARY&quot;,[&quot;cost&quot;]=20,[&quot;types&quot;]={&quot;FAIRY&quot;,&quot;WILD&quot;,&quot;STEEL&quot;},[&quot;skill&quot;]=&quot;BEHEMOTH_BLADE&quot;,[&quot;passive&quot;]=&quot;NONE&quot;,[&quot;evolution&quot;]=&quot;DEFAULT&quot;,[&quot;evolutionRule&quot;]=&quot;count&quot;,[&quot;copies&quot;]=3,[&quot;additional&quot;]=false,[&quot;regional&quot;]=false},[&quot;ZYGARDE_100&quot;]={[&quot;name&quot;]=&quot;ZYGARDE_100&quot;,[&quot;family&quot;]=&quot;ZYGARDE_10&quot;,[&quot;index&quot;]=&quot;0718-0002&quot;,[&quot;hp&quot;]=350,[&quot;attack&quot;]=28,[&quot;defense&quot;]=10,[&quot;speed&quot;]=50,[&quot;range&quot;]=2,[&quot;stars&quot;]=4,[&quot;rarity&quot;]=&quot;LEGENDARY&quot;,[&quot;cost&quot;]=20,[&quot;types&quot;]={&quot;DRAGON&quot;,&quot;GROUND&quot;},[&quot;skill&quot;]=&quot;CORE_ENFORCER&quot;,[&quot;passive&quot;]=&quot;NONE&quot;,[&quot;evolution&quot;]=&quot;DEFAULT&quot;,[&quot;evolutionRule&quot;]=&quot;count&quot;,[&quot;copies&quot;]=3,[&quot;additional&quot;]=false,[&quot;regional&quot;]=false}},[&quot;odds&quot;]={[&quot;1&quot;]={1,0,0,0,0},[&quot;2&quot;]={1,0,0,0,0},[&quot;3&quot;]={0.7,0.3,0,0,0},[&quot;4&quot;]={0.5,0.4,0.1,0,0},[&quot;5&quot;]={0.36,0.42,0.2,0.02,0},[&quot;6&quot;]={0.25,0.4,0.3,0.05,0},[&quot;7&quot;]={0.16,0.33,0.35,0.15,0.01},[&quot;8&quot;]={0.11,0.27,0.35,0.22,0.05},[&quot;9&quot;]={0.05,0.2,0.35,0.3,0.1},[&quot;10&quot;]={0,0.05,0.3,0.4,0.25}},[&quot;thresholds&quot;]={[&quot;NORMAL&quot;]={3,5,7,9},[&quot;GRASS&quot;]={3,5,7,9},[&quot;FIRE&quot;]={2,4,6,8},[&quot;WATER&quot;]={3,6,9},[&quot;ELECTRIC&quot;]={3,5,7},[&quot;FIGHTING&quot;]={2,4,6,8},[&quot;PSYCHIC&quot;]={3,5,7},[&quot;DARK&quot;]={3,5,7},[&quot;STEEL&quot;]={2,4,6,8},[&quot;GROUND&quot;]={2,4,6,8},[&quot;POISON&quot;]={3,5,7},[&quot;DRAGON&quot;]={3,5,7},[&quot;FIELD&quot;]={3,6,9},[&quot;MONSTER&quot;]={2,4,6,8},[&quot;HUMAN&quot;]={2,4,6},[&quot;AQUATIC&quot;]={2,4,6,8},[&quot;BUG&quot;]={2,4,6,8},[&quot;FLYING&quot;]={2,4,6,8},[&quot;FLORA&quot;]={3,4,5,6},[&quot;ROCK&quot;]={2,4,6},[&quot;GHOST&quot;]={2,4,6,8},[&quot;FAIRY&quot;]={2,4,6,8},[&quot;ICE&quot;]={2,4,6,8},[&quot;FOSSIL&quot;]={2,4,6},[&quot;SOUND&quot;]={2,4,6},[&quot;ARTIFICIAL&quot;]={2,4,6},[&quot;BABY&quot;]={3,5,7},[&quot;LIGHT&quot;]={2,3,4,5},[&quot;WILD&quot;]={2,4,6,9},[&quot;AMORPHOUS&quot;]={3,5,7},[&quot;GOURMET&quot;]={3,4,5}}}
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX2"><Properties><string name="Name">Rules</string><ProtectedString name="Source">-- GPL-3.0-only. Pure game rules; no Roblox services required.
local Rules = {}
Rules.Width = 8
Rules.Height = 6
Rules.BenchSize = 8
Rules.ShopSize = 6
local nextId = 0

function Rules.newUnit(name)
    nextId += 1
    return { id = nextId, name = name, x = 0, y = 0 }
end

function Rules.deployed(state)
    local count = 0
    for _, unit in ipairs(state.units) do
        if unit.y &gt; 0 then count += 1 end
    end
    return count
end

function Rules.merge(state, catalog)
    local changed = true
    while changed do
        changed = false
        for _, candidate in ipairs(state.units) do
            local data = catalog.units[candidate.name]
            if data.evolutionRule == 'count' and catalog.units[data.evolution] then
                local matches = {}
                for index, unit in ipairs(state.units) do
                    if unit.name == candidate.name then table.insert(matches, index) end
                end
                local needed = data.copies or 3
                if #matches &gt;= needed then
                    local x, y = candidate.x, candidate.y
                    for index = needed, 1, -1 do table.remove(state.units, matches[index]) end
                    local evolved = Rules.newUnit(data.evolution)
                    evolved.x, evolved.y = x, y
                    table.insert(state.units, evolved)
                    changed = true
                    break
                end
            end
        end
    end
end

function Rules.move(state, id, x, y)
    if type(id) ~= 'number' or type(x) ~= 'number' or type(y) ~= 'number'
        or x ~= math.floor(x) or y ~= math.floor(y)
        or x &lt; 1 or x &gt; Rules.Width or y &lt; 0 or y &gt; 3 then return false end
    local unit, occupant
    for _, current in ipairs(state.units) do
        if current.id == id then unit = current end
        if current.x == x and current.y == y then occupant = current end
    end
    if not unit then return false end
    if unit.y == 0 and y &gt; 0 and (not occupant or occupant.y == 0)
        and Rules.deployed(state) &gt;= state.level then return false end
    if occupant then occupant.x, occupant.y = unit.x, unit.y end
    unit.x, unit.y = x, y
    return true
end

function Rules.synergies(units, catalog)
    local counts, families = {}, {}
    for _, unit in ipairs(units) do
        if unit.y &gt; 0 then
            local data = catalog.units[unit.name]
            if not families[data.family] then
                families[data.family] = true
                for _, kind in ipairs(data.types) do counts[kind] = (counts[kind] or 0) + 1 end
            end
        end
    end
    return counts
end

-- Initial port: basic attacks and movement. Named abilities/passives are metadata only.
function Rules.battle(left, right, catalog)
    local fighters = {}
    for team, units in ipairs({left, right}) do
        for _, unit in ipairs(units) do
            if unit.y &gt; 0 then
                local data = catalog.units[unit.name]
                table.insert(fighters, {id = tostring(team)..':'..unit.id, name = unit.name,
                    team = team, x = unit.x, y = team == 1 and unit.y or 7-unit.y,
                    hp = data.hp, maxHp = data.hp, attack = data.attack,
                    defense = data.defense, range = data.range, cooldown = 0,
                    interval = math.max(1, math.floor(100 / math.max(1, data.speed)))})
            end
        end
    end
    return {fighters = fighters, tick = 0, finished = false, winner = 0}
end

function Rules.step(battle)
    if battle.finished then return end
    battle.tick += 1
    local occupied = {}
    for _, f in ipairs(battle.fighters) do
        if f.hp &gt; 0 then occupied[f.x..':'..f.y] = true end
    end
    for _, fighter in ipairs(battle.fighters) do
        if fighter.hp &gt; 0 then
            local target, distance = nil, math.huge
            for _, enemy in ipairs(battle.fighters) do
                local d = math.abs(enemy.x-fighter.x) + math.abs(enemy.y-fighter.y)
                if enemy.team ~= fighter.team and enemy.hp &gt; 0 and d &lt; distance then
                    target, distance = enemy, d
                end
            end
            if target then
                fighter.cooldown -= 1
                if distance &lt;= fighter.range and fighter.cooldown &lt;= 0 then
                    target.hp = math.max(0, target.hp - math.max(1,
                        math.floor(fighter.attack * 100 / (100 + target.defense*5))))
                    fighter.cooldown = fighter.interval
                    if target.hp == 0 then occupied[target.x..':'..target.y] = nil end
                elseif distance &gt; fighter.range then
                    local bestX, bestY, best = fighter.x, fighter.y, distance
                    for _, direction in ipairs({{1,0},{-1,0},{0,1},{0,-1}}) do
                        local x, y = fighter.x+direction[1], fighter.y+direction[2]
                        local d = math.abs(x-target.x)+math.abs(y-target.y)
                        if x &gt;= 1 and x &lt;= 8 and y &gt;= 1 and y &lt;= 6
                            and not occupied[x..':'..y] and d &lt; best then
                            bestX, bestY, best = x, y, d
                        end
                    end
                    occupied[fighter.x..':'..fighter.y] = nil
                    fighter.x, fighter.y = bestX, bestY
                    occupied[bestX..':'..bestY] = true
                end
            end
        end
    end
    local alive = {0,0}
    for _, f in ipairs(battle.fighters) do if f.hp &gt; 0 then alive[f.team] += 1 end end
    if alive[1] == 0 or alive[2] == 0 or battle.tick &gt;= 120 then
        battle.finished = true
        battle.winner = alive[1] == 0 and (alive[2] == 0 and 0 or 2)
            or (alive[2] == 0 and 1 or 0)
    end
end
return Rules
</ProtectedString></Properties></Item></Item></Item><Item class="ServerScriptService" referent="RBX6"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX5"><Properties><string name="Name">AutoChessServer</string><ProtectedString name="Source">local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')
local Catalog = require(ReplicatedStorage.AutoChess.Catalog)
local Rules = require(ReplicatedStorage.AutoChess.Rules)
local folder = Instance.new('Folder')
folder.Name = 'AutoChessRemotes'
folder.Parent = ReplicatedStorage
local action = Instance.new('RemoteEvent')
action.Name = 'Action'
action.Parent = folder
local update = Instance.new('RemoteEvent')
update.Name = 'Update'
update.Parent = folder
local states, lastAction = {}, {}
local phase, round, remaining = 'Lobby', 0, 0
local activeMatch = false
local rng = Random.new()
local pools = {COMMON={}, UNCOMMON={}, RARE={}, EPIC={}, ULTRA={}}
for name, data in pairs(Catalog.units) do
    if pools[data.rarity] and data.stars == 1 and not data.additional and not data.regional
        and data.skill ~= 'DEFAULT' then table.insert(pools[data.rarity], name) end
end
for _, pool in pairs(pools) do table.sort(pool) end
local rarities = {'COMMON','UNCOMMON','RARE','EPIC','ULTRA'}
local function shop(state)
    local result = {}
    local odds = Catalog.odds[tostring(state.level)]
    for i = 1, 6 do
        local roll, sum, rarity = rng:NextNumber(), 0, 'COMMON'
        for index, chance in ipairs(odds) do
            sum += chance
            if roll &lt;= sum then rarity = rarities[index]; break end
        end
        local pool = pools[rarity]
        if #pool == 0 then pool = pools.COMMON end
        result[i] = pool[rng:NextInteger(1,#pool)]
    end
    return result
end
local function newState(player)
    local state = {name=player.DisplayName, hp=100, gold=10, level=3, xp=0,
        units={}, offers={}, ready=false, playing=false, battle=nil, opponent=''}
    state.offers = shop(state)
    return state
end
local function publish(player)
    local state = states[player]
    if not state or player.Parent ~= Players then return end
    local standings = {}
    for other, data in pairs(states) do
        table.insert(standings, {name=data.name, hp=data.hp, playing=data.playing,
            userId=other.UserId})
    end
    table.sort(standings,function(a,b) return a.hp &gt; b.hp end)
    update:FireClient(player, {phase=phase, round=round, remaining=remaining,
        state=state, standings=standings, synergies=Rules.synergies(state.units,Catalog)})
end
local function publishAll()
    for player in pairs(states) do publish(player) end
end
local function participants()
    local list = {}
    for player, state in pairs(states) do
        if state.playing and state.hp &gt; 0 then table.insert(list,player) end
    end
    table.sort(list,function(a,b) return a.UserId &lt; b.UserId end)
    return list
end
local function countdown(seconds)
    for t=seconds,1,-1 do remaining=t; publishAll(); task.wait(1) end
    remaining=0
end
local function botBoard()
    local result = {}
    for i=1,math.min(6,2+math.floor(round/2)) do
        local unit=Rules.newUnit(pools.COMMON[rng:NextInteger(1,#pools.COMMON)])
        unit.x,unit.y=i,2
        table.insert(result,unit)
    end
    return result
end
local function runMatch()
    phase, round = 'Preparation', 0
    local initial = #participants()
    repeat
        round += 1
        phase='Preparation'
        for _,player in ipairs(participants()) do
            local state=states[player]
            state.battle=nil
            if round &gt; 1 then state.gold += 5+math.min(5,math.floor(state.gold/10)) end
            state.offers=shop(state)
        end
        countdown(25)
        phase='Battle'
        local roster=participants()
        local battles={}
        for i=1,#roster,2 do
            local first,second=roster[i],roster[i+1]
            local enemy = second and states[second].units or botBoard()
            local simulation=Rules.battle(states[first].units,enemy,Catalog)
            table.insert(battles,{first=first,second=second,simulation=simulation})
            states[first].battle=simulation
            states[first].team=1
            states[first].opponent=second and states[second].name or '야생 포켓몬'
            if second then
                states[second].battle=simulation
                states[second].team=2
                states[second].opponent=states[first].name
            end
        end
        for tick=1,120 do
            local done=true
            for _,pair in ipairs(battles) do
                Rules.step(pair.simulation)
                if not pair.simulation.finished then done=false end
            end
            remaining=math.ceil((120-tick)*0.35)
            publishAll()
            if done then break end
            task.wait(0.35)
        end
        for _,pair in ipairs(battles) do
            for team,player in ipairs({pair.first,pair.second}) do
                local state=states[player]
                if state and pair.simulation.winner ~= team then
                    state.hp=math.max(0,state.hp-5-round)
                end
            end
        end
        phase='Results'
        countdown(5)
    until #participants() == 0 or (initial &gt; 1 and #participants() &lt;= 1) or round &gt;= 10
    phase='Finished'
    publishAll()
    task.wait(8)
    phase='Lobby'
    activeMatch=false
    for player in pairs(states) do states[player]=newState(player) end
    publishAll()
end
local function validInteger(value, low, high)
    return type(value)=='number' and value==value and value%1==0 and value&gt;=low and value&lt;=high
end
action.OnServerEvent:Connect(function(player, request)
    if type(request)~='table' or type(request.kind)~='string' then return end
    local state=states[player]
    if not state then return end
    local now=os.clock()
    if now-(lastAction[player] or 0)&lt;0.1 then return end
    lastAction[player]=now
    if request.kind=='Sync' then publish(player); return end
    if request.kind=='Ready' and phase=='Lobby' and not activeMatch then
        state.ready=not state.ready
        if state.ready then
            activeMatch=true
            phase='Starting'
            task.spawn(function()
                countdown(8)
                for _,data in pairs(states) do data.playing=true end
                if #participants()&gt;0 then runMatch() else activeMatch=false;phase='Lobby' end
            end)
        end
        publishAll()
        return
    end
    if phase~='Preparation' or not state.playing or state.hp&lt;=0 then return end
    if request.kind=='Buy' and validInteger(request.slot,1,6) then
        local name=state.offers[request.slot]
        if name and name~='' and Catalog.units[name] then
            local data=Catalog.units[name]
            local bench={}
            for _,unit in ipairs(state.units) do if unit.y==0 then bench[unit.x]=true end end
            local position
            for x=1,8 do if not bench[x] then position=x;break end end
            if position and state.gold&gt;=data.cost then
                state.gold-=data.cost
                state.offers[request.slot]=''
                local unit=Rules.newUnit(name)
                unit.x=position
                table.insert(state.units,unit)
                Rules.merge(state,Catalog)
            end
        end
    elseif request.kind=='Move' and validInteger(request.id,1,1e12)
        and validInteger(request.x,1,8) and validInteger(request.y,0,3) then
        Rules.move(state,request.id,request.x,request.y)
    elseif request.kind=='Sell' and validInteger(request.id,1,1e12) then
        for index,unit in ipairs(state.units) do
            if unit.id==request.id then
                state.gold+=Catalog.units[unit.name].cost
                table.remove(state.units,index)
                break
            end
        end
    elseif request.kind=='Refresh' and state.gold&gt;=2 then
        state.gold-=2
        state.offers=shop(state)
    elseif request.kind=='Experience' and state.gold&gt;=4 and state.level&lt;9 then
        state.gold-=4
        state.xp+=4
        local costs={0,2,6,10,22,34,52,72,72}
        while state.level&lt;9 and state.xp&gt;=costs[state.level+1] do
            state.xp-=costs[state.level+1]
            state.level+=1
        end
    end
    publish(player)
end)
local function joined(player)
    local count=0
    for _ in pairs(states) do count+=1 end
    if not states[player] and count&gt;=8 then
        player:Kick('이 서버는 최대 8명이 플레이할 수 있습니다.')
        return
    end
    if not states[player] then states[player]=newState(player) end
    publishAll()
end
Players.PlayerAdded:Connect(joined)
Players.PlayerRemoving:Connect(function(player)
    states[player],lastAction[player]=nil,nil
    publishAll()
end)
for _,player in ipairs(Players:GetPlayers()) do joined(player) end
</ProtectedString></Properties></Item></Item><Item class="StarterPlayer" referent="RBX9"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX8"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX7"><Properties><string name="Name">AutoChessClient</string><ProtectedString name="Source">local Players=game:GetService('Players')
local ReplicatedStorage=game:GetService('ReplicatedStorage')
local Catalog=require(ReplicatedStorage:WaitForChild('AutoChess'):WaitForChild('Catalog'))
local remotes=ReplicatedStorage:WaitForChild('AutoChessRemotes')
local action=remotes:WaitForChild('Action')
local update=remotes:WaitForChild('Update')
local player=Players.LocalPlayer
local gui=Instance.new('ScreenGui')
gui.Name='AutoChessUI'
gui.ResetOnSpawn=false
gui.IgnoreGuiInset=false
gui.Parent=player:WaitForChild('PlayerGui')
local root=Instance.new('Frame')
root.Size=UDim2.fromScale(1,1)
root.BackgroundColor3=Color3.fromRGB(15,22,36)
root.Parent=gui
local selected=nil
local latest=nil
local function send(kind,values)
    values=values or {}
    values.kind=kind
    action:FireServer(values)
end
local function label(parent,text,x,y,w,h,button)
    local object=Instance.new(button and 'TextButton' or 'TextLabel')
    object.Position=UDim2.fromScale(x,y)
    object.Size=UDim2.fromScale(w,h)
    object.Text=text
    object.TextScaled=true
    object.Font=Enum.Font.Gotham
    object.TextColor3=Color3.fromRGB(235,242,255)
    object.BackgroundColor3=Color3.fromRGB(34,49,72)
    object.BorderSizePixel=0
    object.Parent=parent
    local padding=Instance.new('UIPadding')
    padding.PaddingLeft=UDim.new(0,4)
    padding.PaddingRight=UDim.new(0,4)
    padding.Parent=object
    local corner=Instance.new('UICorner')
    corner.CornerRadius=UDim.new(0,5)
    corner.Parent=object
    return object
end
local phaseNames={Lobby='로비',Starting='시작 대기',Preparation='준비',Battle='전투',Results='결과',Finished='경기 종료'}
local function draw(payload)
    latest=payload
    root:ClearAllChildren()
    local state=payload.state
    local known=false
    for _,unit in ipairs(state.units) do if unit.id==selected then known=true end end
    if not known then selected=nil end
    label(root,'POKÉMON AUTO CHESS · ROBLOX PORT',0.02,0.01,0.76,0.045)
    label(root,string.format('%s · R%d · %ds | HP %d · 골드 %d · Lv%d (%d XP)',
        phaseNames[payload.phase] or payload.phase,payload.round,payload.remaining,
        state.hp,state.gold,state.level,state.xp),0.02,0.065,0.76,0.045)
    label(root,'유닛 선택 → 아래쪽 보드/벤치 클릭으로 배치 · 전투 중에는 수정 불가',0.02,0.12,0.76,0.035)
    local pieces={}
    if payload.phase=='Battle' or payload.phase=='Results' then
        if state.battle then
            for _,fighter in ipairs(state.battle.fighters) do
                local y=state.team==2 and 7-fighter.y or fighter.y
                if fighter.hp&gt;0 then pieces[fighter.x..':'..y]=fighter end
            end
        end
    else
        for _,unit in ipairs(state.units) do
            if unit.y&gt;0 then pieces[unit.x..':'..unit.y]=unit end
        end
    end
    for y=6,1,-1 do
        for x=1,8 do
            local piece=pieces[x..':'..y]
            local text=piece and piece.name:gsub('_',' ') or ''
            if piece and piece.hp then text..='\n'..piece.hp..'/'..piece.maxHp end
            if piece and piece.id==selected then text='▶ '..text end
            local cell=label(root,text,0.02+(x-1)*0.095,0.17+(6-y)*0.072,0.09,0.065,true)
            cell.BackgroundColor3=y&gt;3 and Color3.fromRGB(66,35,49) or Color3.fromRGB(26,66,69)
            cell.Activated:Connect(function()
                if payload.phase~='Preparation' then return end
                if selected and y&lt;=3 then send('Move',{id=selected,x=x,y=y});selected=nil
                elseif piece then selected=piece.id;draw(latest) end
            end)
        end
    end
    for x=1,8 do
        local unit
        for _,item in ipairs(state.units) do if item.y==0 and item.x==x then unit=item end end
        local text=unit and unit.name:gsub('_',' ') or '벤치 '..x
        if unit and unit.id==selected then text='▶ '..text end
        local cell=label(root,text,0.02+(x-1)*0.095,0.62,0.09,0.065,true)
        cell.Activated:Connect(function()
            if payload.phase~='Preparation' then return end
            if selected then send('Move',{id=selected,x=x,y=0});selected=nil
            elseif unit then selected=unit.id;draw(latest) end
        end)
    end
    for slot=1,6 do
        local name=state.offers[slot]
        local data=Catalog.units[name]
        local text=data and (name:gsub('_',' ')..'\n'..data.cost..'G · '..table.concat(data.types,'/')) or '판매 완료'
        local card=label(root,text,0.02+(slot-1)*0.127,0.72,0.12,0.11,true)
        card.Activated:Connect(function() send('Buy',{slot=slot}) end)
    end
    local buttons={{'시작 / 준비','Ready'},{'새로고침 2G','Refresh'},{'경험치 +4 / 4G','Experience'},{'선택 유닛 판매','Sell'}}
    for i,item in ipairs(buttons) do
        local button=label(root,item[1],0.02+(i-1)*0.19,0.86,0.18,0.06,true)
        button.Activated:Connect(function()
            if item[2]=='Sell' then if selected then send('Sell',{id=selected});selected=nil end
            else send(item[2]) end
        end)
    end
    label(root,'플레이어',0.81,0.02,0.17,0.05)
    for i,standing in ipairs(payload.standings) do
        label(root,standing.name..' · '..standing.hp..' HP',0.81,0.08+(i-1)*0.05,0.17,0.045)
    end
    local synergies={}
    for kind,count in pairs(payload.synergies) do table.insert(synergies,kind..' '..count) end
    table.sort(synergies)
    label(root,'타입 수집\n'..table.concat(synergies,'\n'),0.81,0.52,0.17,0.25)
    label(root,'초기 이식 버전\n스킬·아이템·시너지 효과 미구현\n그래픽: 임시 텍스트',0.81,0.8,0.17,0.14)
end
update.OnClientEvent:Connect(draw)
send('Sync')
</ProtectedString></Properties></Item></Item></Item><Item class="Workspace" referent="RBX10"><Properties><string name="Name">Workspace</string></Properties><Item class="SpawnLocation" referent="RBXSPAWN"><Properties><string name="Name">Spawn</string><bool name="Anchored">true</bool><Vector3 name="Size"><X>32</X><Y>1</Y><Z>32</Z></Vector3><CoordinateFrame name="CFrame"><X>0</X><Y>0</Y><Z>0</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame></Properties></Item></Item></roblox>